generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Technical marker only: TASK-02 needs a real, repeatable migration.
model DatabaseMarker {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  @@map("_database_marker")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Product {
  id                   Int      @id @default(autoincrement())
  name                 String
  unit                 String
  currentStock         Int
  minimumStock         Int
  consumptionDays      Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  saleItems            SaleItem[]
}

model Sale {
  id         Int        @id @default(autoincrement())
  customerId Int
  soldAt     DateTime
  status     String
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items      SaleItem[]

  @@index([customerId])
}

model SaleItem {
  id                   Int       @id @default(autoincrement())
  saleId               Int
  productId            Int
  quantity             Int
  unitPrice            Decimal?
  expectedRepurchaseAt DateTime?
  sale                 Sale      @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product              Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId])
  @@index([productId])
}
